{
  "name": "certiflow-backend",
  "version": "1.0.0",
  "description": "CertiFlow Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "worker": "ts-node-dev --respawn --transpile-only src/workers/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.14.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.2",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4",
    "uuid": "^9.0.0",
    "node-cron": "^3.0.3",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/papaparse": "^5.3.14",
    "@types/pdfkit": "^0.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "prisma": "^5.7.0",
    "@types/node-cron": "^3.0.11"
  }
}
